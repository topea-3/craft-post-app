{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Craft Post",
  "version": "0.1.1",
  "identifier": "com.topea.craftpost",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Craft Post",
        "width": 1220,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Toshiya Takizawa",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "licenses/LICENSE",
    "resources": [
      "licenses/LICENSE",
      "licenses/THIRD_PARTY_NOTICES.md",
      "licenses/noto-serif-jp-OFL.txt",
      "licenses/noto-serif-jp-README.md"
    ]
  }
}
